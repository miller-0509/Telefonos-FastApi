# ====================== ElectroPhone - Configuración ======================
# Copia este archivo como `.env` y ajusta los valores según tu entorno.
# El archivo `.env` NO se sube a git.

# --- Aplicación ---
PROJECT_NAME=ElectroPhone Store
PROJECT_VERSION=1.0.0

# --- Seguridad JWT ---
# IMPORTANTE: cámbialo en producción
SECRET_KEY=super-secret-key-change-in-production-telefonos-fastapi-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Base de datos ---
# SQLite (por defecto):
DATABASE_URL=sqlite:///./telefonos.db
# PostgreSQL (ejemplo):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/electrophone

# --- Admin por defecto ---
FIRST_ADMIN_EMAIL=admin@electrophone.com
FIRST_ADMIN_PASSWORD=admin123456

# --- URL pública de la app (para enlaces de verificación) ---
APP_BASE_URL=http://127.0.0.1:8000

# --- Email / SMTP (verificación por correo) ---
# Deja SMTP_HOST vacío para "enviar" por consola en desarrollo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@electrophone.com
SMTP_FROM_NAME=ElectroPhone Store
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- CORS ---
# Orígenes permitidos separados por coma. Usa "*" solo en desarrollo.
# Para producción, indica los dominios de tus frontends:
# CORS_ORIGINS=https://app.tudominio.com
CORS_ORIGINS=*

# --- Blockchain / Escrow (USDC) ---
# Desactivado por defecto. Actívalo tras desplegar los contratos.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Déjalas vacías para leerlas de blockchain/deployments/localhost.json
BLOCKCHAIN_ESCROW_ADDRESS=
BLOCKCHAIN_USDC_ADDRESS=
# Cuenta local de Hardhat #0 (NO usar en producción). La clave privada real va solo en .env
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_SELLER_ADDRESS=
# Conversión usada para pasar el total de la orden (COP) a USDC
BLOCKCHAIN_COP_PER_USDC=4000
BLOCKCHAIN_DEADLINE_DAYS=14
BLOCKCHAIN_TX_TIMEOUT=120
BLOCKCHAIN_EXPLORER_URL=
BLOCKCHAIN_DEPLOYMENT_FILE=blockchain/deployments/localhost.json

# --- Despliegue (Coolify / Docker Compose) ---
# URL del backend que usará el frontend Flutter (se quema en el build)
API_BASE_URL=https://api.tudominio.com/api/v1